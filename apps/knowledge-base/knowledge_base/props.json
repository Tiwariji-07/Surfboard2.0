[
  {
    "type": "widget_caption",
    "property": "caption",
    "applicable_widgets": [
      "label",
      "anchor",
      "button",
      "Tabs",
      "Panel",
      "Accordion",
      "Wizard",
      "RadioSet",
      "CheckboxSet",
      "Menu"
    ],
    "syntax": "{Page/Partial/Prefab/App}.Widgets.{widgetName}.caption",
    "examples": [
      "Page.Widgets.priceLabel.caption = '24.3$'",
      "Partial.Widgets.title.caption = 'News'",
      "Prefab.Widgets.saveButton.caption = 'update'"
    ]
  },
  {
    "type": "widget_show",
    "property": "show",
    "applicable_widgets": [
      "Cards",
      "DataTable",
      "Form",
      "List",
      "LiveFilter",
      "LiveForm",
      "Accordion",
      "Container",
      "GridLayout",
      "Panel",
      "Tabs",
      "Tile",
      "Wizard",
      "Button",
      "ButtonGroup",
      "Calendar",
      "Checkbox",
      "CheckboxSet",
      "Chips",
      "ColorPicker",
      "Currency",
      "Date",
      "Datetime",
      "FileUpload",
      "Number",
      "Radio",
      "RadioSet",
      "Rating",
      "Select",
      "Slider",
      "Switch",
      "Text",
      "TextArea",
      "Time",
      "Anchor",
      "Icon",
      "Label",
      "Picture",
      "ProgressBar",
      "Spinner",
      "AreaChart",
      "BarChart",
      "ColumnChart",
      "DonutChart",
      "LineChart",
      "PieChart",
      "Breadcrumb",
      "Menu",
      "Navbar",
      "Tree",
      "BarcodeScanner",
      "Signature"
    ],
    "description": "Showing determines whether or not a component is visible. A page element that is not showing has its css display style set to none; it is still a part of the DOM model of the page, but no longer affects the layout of other components.",
    "syntax": "{Page/Partial/Prefab/App}.Widgets.{widgetName}.show",
    "examples": [
      "Page.Widgets.picture1.show = false",
      "Partial.Widgets.container2.show = true",
      "Prefab.Widgets.employeeList.show = (App.Variables.userDetails.role == 'Admin')"
    ]
  },
  {
    "type": "widget_datavalue",
    "property": "datavalue",
    "applicable_widgets": [
      "text",
      "textArea",
      "number",
      "currency",
      "date",
      "datetime",
      "time",
      "fileUpload",
      "checkbox",
      "checkboxSet",
      "radio",
      "radioSet",
      "select",
      "chips",
      "slider",
      "switch",
      "rating",
      "calendar",
      "colorPicker"
    ],
    "description": "The datavalue is the value of a widget. It holds the user input or selected value for form elements and selection controls.",
    "syntax": "{Page/Partial/Prefab/App}.Widgets.{widgetName}.datavalue",
    "examples": [
      "Page.Widgets.selectedLanguage.caption = Page.Widgets.languageSelect.datavalue",
      "Partial.variables.getEmployeeDetails.setInput('emp_id', Partial.Widgets.employeeID.datavalue)",
      "Prefab.Widgets.saveButton.height = Page.Widgets.heightPicker.datavalue"
    ]
  },
  {
    "type": "widget_disabled",
    "property": "disabled",
    "applicable_widgets": [
      "text",
      "textArea",
      "number",
      "currency",
      "date",
      "datetime",
      "time",
      "fileUpload",
      "checkbox",
      "checkboxSet",
      "radio",
      "radioSet",
      "select",
      "chips",
      "slider",
      "switch",
      "rating",
      "button",
      "buttonGroup",
      "calendar",
      "colorPicker"
    ],
    "description": "If the disabled property is true (checked) the value of the editor cannot change. The widget becomes display-only.",
    "syntax": "{Page/Partial/Prefab/App}.Widgets.{widgetName}.disabled",
    "examples": [
      "Page.Widgets.picture1.disable = false",
      "Partial.Widgets.container2.disable = true",
      "Prefab.Widgets.employeeList.disable = (App.Variables.userDetails.role == 'Admin')"
    ]
  }
]
